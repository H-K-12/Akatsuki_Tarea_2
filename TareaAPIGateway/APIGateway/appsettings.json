{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Services": {
    "Productos": "http://localhost:5063/",
    "Pedidos": "http://localhost:5282/"
  },
  "ReverseProxy": {
    "Routes": {
      "productos": {
        "ClusterId": "productos",
        "Match": {
          "Path": "/api/productos/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Gateway",
            "Set": "Akatsuki-ApiGateway"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Set": "Akatsuki-ApiGateway",
            "When": "Always"
          }
        ]
      },
      "ordenes": {
        "ClusterId": "pedidos",
        "Match": {
          "Path": "/api/ordenes/{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Gateway",
            "Set": "Akatsuki-ApiGateway"
          },
          {
            "ResponseHeader": "X-Gateway",
            "Set": "Akatsuki-ApiGateway",
            "When": "Always"
          }
        ]
      }
    },
    "Clusters": {
      "productos": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "productos-api": {
            "Address": "http://localhost:5063/"
          }
        }
      },
      "pedidos": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "pedidos-api": {
            "Address": "http://localhost:5282/"
          }
        }
      }
    }
  }
}
